{
  "openapi": "3.0.1",
  "info": {
    "title": "ShelfsService",
    "version": "1.0"
  },
  "paths": {
    "/shelfs/add-shelf": {
      "post": {
        "tags": [
          "ShelfsService"
        ],
        "operationId": "ShelfsServicesrcUserServiceHostFeaturesShelfsCreateShelfCommandHandler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShelfCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShelfDto"
                }
              }
            }
          }
        }
      }
    },
    "/shelfs": {
      "get": {
        "tags": [
          "ShelfsService"
        ],
        "operationId": "ShelfsServicesrcShelfsServiceHostFeaturesShelfsGetAllShelfs",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllShelfsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/shelfs/items/{itemId}": {
      "get": {
        "tags": [
          "ShelfsService"
        ],
        "operationId": "ShelfsServicesrcShelfsServiceHostFeaturesItemsGetItemById",
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/GetItemByIdRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetItemByIdRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/WeatherForecast": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateShelfCommand": {
        "type": "object",
        "properties": {
          "newShelf": {
            "$ref": "#/components/schemas/CreateShelfDto"
          }
        },
        "additionalProperties": false
      },
      "CreateShelfDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "GetAllShelfsResponse": {
        "type": "object",
        "properties": {
          "shelfs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShelfDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "GetItemByIdRequest": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "ItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "shelfId": {
            "type": "string",
            "format": "uuid"
          },
          "bigImage": {
            "type": "string",
            "nullable": true
          },
          "dateCreated": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemTag"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ItemPreviewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "smallImage": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ItemTag": {
        "required": [
          "name",
          "tagTypeId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "tagTypeId": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "$ref": "#/components/schemas/TagType"
          },
          "source": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ShelfDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "dateCreated": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemPreviewDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TagType": {
        "required": [
          "description",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}