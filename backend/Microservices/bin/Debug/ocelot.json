{
  "Routes": [
    {
      // --- UPSTREAM CONFIGURATION (What the client calls) ---
      "UpstreamPathTemplate": "/api/users/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],

      // --- DOWNSTREAM CONFIGURATION (Where the Gateway routes the call) ---
      // **Crucial**: Use the Docker Compose service name for the Host
      "DownstreamPathTemplate": "/api/users/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "userservice",
          "Port": 8080
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    // You can set a global base URL here if needed
  }
}