{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http2"
      }
    }
  },
  "StorageSettings": {
    "ImagesPath": "/app/images"
  },
  "GrpcSettings": {
    "ParseImageServiceUrl": "http://parseimageservice:5000"
  }
}
