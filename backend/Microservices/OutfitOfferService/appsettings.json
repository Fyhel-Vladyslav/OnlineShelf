{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenWeatherApiKey" : "",
  "GrpcSettings": {
    "ShelfsServiceUrl": "http://shelfsservice:8082",
    "OutfitNetworkServiceUrl": "http://outfitnetworkservice:8080",
    "ImageServiceUrl": "http://imageservice:8080",
    "ParseImageServiceUrl": "http://parseimageservice:50051"
  },
  // Черга еталонних фото дизайнера (фото -> ParseImageService.AnalyzeOutfit). Рядок підключення ConnectionStrings:OfferDbConnection
  // береться зі змінних середовища docker compose або з appsettings.Development.json.
  "ReferenceProcessing": {
    "Parallelism": 1,
    "PollIntervalSeconds": 2,
    "LockMinutes": 5,
    "AnalyzeDeadlineSeconds": 120,
    "RetryDelaysSeconds": [ 30, 120, 600 ]
  },
  "Weather": {
    "CacheTtlMinutes": 30,
    "CoordinateDecimals": 2
  },
  "OutfitGeneration": {
    "BeamWidth": 20,
    "MaxFirstSlotCandidates": 50,
    "DefaultTopN": 5,
    "MaxTopN": 20,
    // Множник скору за кожну річ, що вже є в обраних образах топу (1 — без диверсифікації)
    "DiversityPenalty": 0.9,
    "WarmupOnStartup": true,
    "WarmupMaxAttempts": 30,
    "WarmupRetryDelaySeconds": 2,
    "SeasonTolerance": 2,
    "OuterwearRequiredBelowCelsius": 12,
    "OuterwearForbiddenAboveCelsius": 22,
    // Ключі AttributeType з довідника shelf_service.AttributesValues (AttributeId=3, класи YOLO з classes.json).
    // 21 tights, 27 flower, 28 ruffle в образ не потрапляють.
    "Slots": {
      "Top": [ 1, 2, 3, 4, 6 ],
      "Outerwear": [ 5, 10, 13 ],
      "Bottom": [ 7, 8, 9 ],
      "FullBody": [ 11, 12 ],
      "Shoes": [ 23 ],
      "Accessory": [ 14, 15, 16, 17, 18, 19, 20, 22, 24, 25, 26 ]
    }
  }
}
